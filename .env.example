# Copiez ce fichier en .env et remplissez avec les valeurs de votre projet Supabase
# (Tableau de bord Supabase > Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Facultatif en développement. En déploiement même origine, le client utilise /game.
VITE_GAME_SERVER_URL=

# Serveur de jeu uniquement — ne jamais préfixer ces valeurs par VITE_.
JWT_SECRET=
SERVICE_ROLE_KEY=
POSTGREST_URL=http://127.0.0.1:3000
PORT=2567
